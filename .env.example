# Copy to .env and fill in. Nothing here is required to build or to run `mvn test`.

# --- LLM -------------------------------------------------------------------
OPENAI_API_KEY=
# Hard ceiling in USD for a single run. The run aborts once metered spend
# exceeds this, rather than discovering the bill afterwards.
LIMINER_MAX_RUN_USD=5.00

# --- Public registers ------------------------------------------------------
# SEC EDGAR fair-access and the UK/EU registers require an identifiable contact
# address in the User-Agent. Requests fall back to a placeholder if unset.
LIMINER_CONTACT_EMAIL=
COMPANIES_HOUSE_API_KEY=
FCA_API_KEY=
FCA_API_EMAIL=

# --- Retrieval and contact discovery ---------------------------------------
BRIGHT_DATA_API_TOKEN=
HUNTER_API_KEY=
EMAIL_VERIFIER_URL=
EMAIL_VERIFIER_API_KEY=

# --- Email intake ----------------------------------------------------------
LIMINER_GMAIL_LABEL=
# Account used by the no-argument CLI intake entry point.
LIMINER_DEFAULT_USER=

# --- Web server ------------------------------------------------------------
LIMINER_HOST=127.0.0.1
LIMINER_PORT=7070

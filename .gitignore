# ==========================================================================
# Liminer AI — .gitignore
# This file lives at the repo root and is shared with everyone who clones.
# It tells Git which files to NEVER track. Anything listed here stays local.
# ==========================================================================

# --- SECRETS: never commit these ------------------------------------------
# Real Google OAuth client credentials
src/main/resources/credentials.json
# Stored OAuth token(s)
/tokens/
# Common secret patterns (belt-and-suspenders)
*.env
.env
.env.*
*.pem
*.p12
*.key

# Keep the safe template (negates the .env patterns above)
!.env.example

# --- Keep the safe template (negate the credentials ignore above) ---------
!src/main/resources/credentials.json.example

# --- Build output (regenerated by Maven) ----------------------------------
target/

# --- Generated / local helper files ---------------------------------------
cp.txt
Launch Liminer.command

# --- Internal ops log (stays in the private working repo) -----------------
ChangeLog.csv

# --- Local data & test fixtures (may contain real LP/fund names) ----------
/ExtraDocuments/
data/scout/

# --- OS / editor junk ------------------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
*.iml
.idea/
.vscode/
tasks/
